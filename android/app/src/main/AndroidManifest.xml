<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect's client says minSdk 26; HealthConnectPlugin checks for
         Android 9+ before touching it, so older phones just don't offer it. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Health Connect opens this to explain why the app wants access (the
             permission screen's link before Android 14), and the alias from
             Android 14's settings. Health Connect refuses to show the
             permission screen to an app that has neither. -->
        <activity
            android:name=".HealthPermissionsRationaleActivity"
            android:label="@string/health_rationale_title"
            android:theme="@style/AppTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The buttons on the workout-in-progress notification (WorkoutNotifier). -->
        <receiver
            android:name=".WorkoutNotificationReceiver"
            android:exported="false" />

        <!-- The home-screen widgets: today's diet, and the week's workouts. -->
        <receiver
            android:name=".DietWidget"
            android:exported="false"
            android:label="@string/widget_diet_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_diet_info" />
        </receiver>
        <receiver
            android:name=".WorkoutWidget"
            android:exported="false"
            android:label="@string/widget_workout_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_workout_info" />
        </receiver>

        <!-- Push notifications (Firebase): the status-bar icon, and the channel for a
             message that names none. The app creates its channels on registration
             (public/js/push.js); src/fcm.js picks one per message. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Food barcode scanner and profile photo (getUserMedia). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Push notifications, which Android 13+ has to ask for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ask Coach voice mode. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Connected apps: daily totals read from Health Connect (HealthConnectPlugin). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Lets the app see whether the Health Connect app is installed (Android 9–13). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
