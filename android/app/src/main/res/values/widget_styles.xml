<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A day in the workout widget's week strip. -->
    <style name="WidgetDay">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/widget_day_empty</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One of the workout notification's buttons on the workout widget. -->
    <style name="WidgetAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button_soft</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_brand</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
