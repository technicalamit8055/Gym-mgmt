{
  "name": "gymbook",
  "version": "1.0.0",
  "description": "Gym management software: members, memberships, billing, check-ins, classes, trainers and equipment",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"tests/**/*.test.js\"",
    "vendor:jsqr": "node scripts/vendor-jsqr.js",
    "vendor:zxing": "node scripts/vendor-zxing.js",
    "icons:gen": "node scripts/gen-icons.js",
    "icons:gen:library": "node scripts/gen-icons-library.js",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/open-emulator.ps1",
    "seed:store": "node --no-warnings=ExperimentalWarning scripts/seed-store.js",
    "android:apk": "node scripts/android.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@simplewebauthn/server": "^13.3.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^5.2.1",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "playwright": "^1.62.1"
  }
}
