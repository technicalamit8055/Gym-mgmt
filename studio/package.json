{
  "name": "coachbook-studio",
  "version": "1.1.1",
  "description": "CoachBook Studio: the always-on-top class controller for classroom smartboards",
  "author": "CoachBook",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "build": {
    "appId": "in.coachbook.studio",
    "productName": "CoachBook Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**",
      "src/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CoachBook Studio",
      "include": "build/installer.nsh",
      "artifactName": "CoachBook-Studio-Setup-${version}.${ext}"
    }
  }
}
