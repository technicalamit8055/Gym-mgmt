# GymBook Environment Configuration Example
# Copy to .env for local development. Everything here is optional — see the
# README's Configuration table for defaults and the full list.
# Enables the operator console at /#/platform. Both must be set, or it 404s.
# The console is also where you issue a password reset for a locked-out gym.
PLATFORM_ADMIN_EMAIL=admin@gymbook.local
PLATFORM_ADMIN_PASSWORD=admin12345

# Backups. The server takes one every 24h in production; set a number of hours
# here to enable the timer in development too, or 0 to leave it to cron.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Off-site backups to any S3-compatible store (Cloudflare R2, B2, MinIO, S3).
# Uploads stay disabled until all four of these are set — a local-only snapshot
# does not survive losing the machine it is on.
# BACKUP_S3_BUCKET=gymbook-backups
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto

# Push notifications. The VAPID key pair is generated on first boot and kept
# beside the platform DB (vapid-keys.json) — back it up; replacing it
# unsubscribes every member. Apple requires a real mailto:/https: subject.
# VAPID_SUBJECT=mailto:you@yourgym.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Custom domains: gyms running the app at their own address (app.theirgym.com).
# Off until CUSTOM_DOMAIN_TARGET is set, and it needs on-demand TLS in front
# (e.g. Caddy). See docs/CUSTOM_DOMAINS.md.
# CUSTOM_DOMAIN_TARGET=domains.yourplatform.com
# CUSTOM_DOMAIN_IPV4=203.0.113.10

# USDA FoodData Central (get a free key at https://fdc.nal.usda.gov/api-key-signup)
# USDA_API_KEY=

# Ask Coach in the member app: Gemini on Google Vertex AI. Off until
# GOOGLE_CLOUD_PROJECT is set. Create a service account with the "Vertex AI
# User" role, download its JSON key and point GOOGLE_APPLICATION_CREDENTIALS
# at it. Check the current Gemini model id in the Vertex AI console.
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AI_COACH_MODEL=gemini-3.8-flash
# AI_COACH_DAILY_LIMIT=20

# Email, for members' "Forgot password?" codes. Off until SMTP_HOST is set —
# members can still get a temporary password on WhatsApp (once a day) from the
# gym's linked WhatsApp, or the front desk can send one from the member's page. Any SMTP provider works: Gmail (with an
# app password), Zoho, Brevo, Amazon SES, Resend, ...
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourgym.com
# SMTP_PASS=your-app-password
# MAIL_FROM=you@yourgym.com
